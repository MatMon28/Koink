{
  "id": "./",
  "name": "Koink — Money Journal",
  "short_name": "Koink",
  "description": "A local-first journal for income, expenses, budgets and savings. No account, no backend; your data stays on this device.",
  "start_url": "./?view=app&source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#EFE9DD",
  "theme_color": "#EFE9DD",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "finance",
    "productivity",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Open Koink on the Add expense sheet",
      "url": "./?view=app&add=expense",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Open Koink on the Add income sheet",
      "url": "./?view=app&add=income",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
