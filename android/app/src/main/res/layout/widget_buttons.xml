<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared by the three Koink widgets. RemoteViews may only use framework widget classes.
  The tray is as wide as the widget and as tall as its rows, centred vertically, and has a semitransparent
  background (tray_bg, tinted with the app's surface colour at about 70 %; hidden for a lone button). The
  buttons spread out when the widget is made wider (KoinkWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/tray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/tray_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_tray_bg" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="6dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/widget_empty"
        android:textColor="#24201C"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
