<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent launch-screen icon: the system launch screen shows only the app's background
  colour (values/splash_themes.xml, LaunchBackground.java), so the first thing the app draws is the
  launch animation, on that same colour. It has to stay an explicit drawable: with no icon set,
  Android 12+ falls back to the launcher icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h288v288h-288z" />
</vector>
