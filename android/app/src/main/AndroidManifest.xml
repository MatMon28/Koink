<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A tap on a home-screen widget button: koink://widget?a=<action> (src/lib/widgets.ts) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="koink" android:host="widget" />
            </intent-filter>

        </activity>

        <!-- Shown when a single-button widget is placed (and when it is reconfigured): which button it is -->
        <activity
            android:name=".KoinkWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets: KoinkWidgetProvider.java, drawn from what the web app hands over (KoinkDevice.setWidgets) -->
        <receiver
            android:name=".KoinkWidgetProvider$Single"
            android:exported="true"
            android:label="@string/widget_single_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_info" />
        </receiver>

        <receiver
            android:name=".KoinkWidgetProvider$Multi"
            android:exported="true"
            android:label="@string/widget_multi_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_multi_info" />
        </receiver>

        <receiver
            android:name=".KoinkWidgetProvider$Categories"
            android:exported="true"
            android:label="@string/widget_categories_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_categories_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reminder notifications (Settings > Notifications). The Local Notifications plugin declares the
         same permissions in its own manifest; they are repeated here so that everything the app asks
         for is visible in one place. POST_NOTIFICATIONS is requested at run time on Android 13+, the
         first time a reminder is switched on. RECEIVE_BOOT_COMPLETED lets the plugin restore the
         repeating alarms after a restart. Without the "alarms & reminders" access behind
         SCHEDULE_EXACT_ALARM the plugin falls back to inexact alarms (a few minutes late at most). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
